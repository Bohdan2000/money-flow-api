# MongoDB connection (default: mongodb://localhost:27017/money-flow)
MONGODB_URI=mongodb://localhost:27017/money-flow

# Server port (default: 3000)
PORT=3000

# JWT signing secret (use a strong random value in production)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Google OAuth 2.0 Client ID (for Google Sign-In; create in Google Cloud Console)
GOOGLE_CLIENT_ID=
